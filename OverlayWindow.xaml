<Window x:Class="OfficeTouchBar.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="58" Height="274" AllowsTransparency="True" Background="Transparent"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True" Focusable="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style x:Key="SquareButton" TargetType="Button">
      <Setter Property="Width" Value="44"/><Setter Property="Height" Value="44"/>
      <Setter Property="MinHeight" Value="44"/><Setter Property="Margin" Value="2"/>
      <Setter Property="Padding" Value="0"/><Setter Property="Focusable" Value="False"/>
      <Setter Property="Background" Value="#33FFFFFF"/><Setter Property="Foreground" Value="#FF353A40"/>
      <Setter Property="BorderBrush" Value="#5590969E"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#CFFFFFFF"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#FFE0EDE7"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Icon" TargetType="Path">
      <Setter Property="Stroke" Value="#FF353A40"/><Setter Property="StrokeThickness" Value="1.7"/>
      <Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="Fill" Value="Transparent"/>
      <Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="Stretch" Value="Uniform"/>
    </Style>
    <Style x:Key="Swatch" TargetType="Button" BasedOn="{StaticResource SquareButton}">
      <Setter Property="Width" Value="44"/><Setter Property="Height" Value="44"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ColorSurface" Background="White" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0">
          <Border Background="{TemplateBinding Background}" Margin="2">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ColorSurface" Property="Opacity" Value="0.85"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SizeSlider" TargetType="Slider">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
        <Grid VerticalAlignment="Center" Height="32">
          <Border Height="6" Background="#FFDDE2E0" CornerRadius="3" VerticalAlignment="Center"/>
          <Track x:Name="PART_Track" VerticalAlignment="Center" Height="20">
            <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False" BorderThickness="0" Background="#FF278A70">
              <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="6" Background="{TemplateBinding Background}" CornerRadius="3" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template>
            </RepeatButton></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb Width="20" Height="20" Cursor="Hand">
              <Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="White" Stroke="#FF278A70" StrokeThickness="2"/></ControlTemplate></Thumb.Template>
            </Thumb></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Opacity="0"/></Track.IncreaseRepeatButton>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="ContentRoot">
    <Grid.LayoutTransform><ScaleTransform x:Name="ContentScale"/></Grid.LayoutTransform>
    <Border x:Name="PenPalette" Width="304" HorizontalAlignment="Left" VerticalAlignment="Center"
            Visibility="Collapsed" Background="#33FFFFFF" BorderBrush="#5590969E" BorderThickness="1" CornerRadius="5" Padding="7">
      <StackPanel>
        <Button Style="{StaticResource SquareButton}" HorizontalAlignment="Right" ToolTip="关闭墨迹工具" Click="ClosePaletteButton_OnClick">
          <Path Style="{StaticResource Icon}" Data="M5,5 L19,19 M19,5 L5,19"/>
        </Button>
        <UniformGrid Columns="4">
          <Button x:Name="MouseToolButton" Style="{StaticResource SquareButton}" ToolTip="鼠标光标" Tag="Mouse" Click="PointerToolButton_OnClick"><Path Style="{StaticResource Icon}" Data="M3,2 L3,22 L8,17 L12,25 L16,23 L12,15 L20,15 Z"/></Button>
          <Button x:Name="PenToolButton" Style="{StaticResource SquareButton}" ToolTip="普通笔" Tag="Pen" Click="PointerToolButton_OnClick"><Path Style="{StaticResource Icon}" Data="M3,21 L5,14 L17,2 L23,8 L11,20 Z M15,4 L21,10 M5,14 L11,20"/></Button>
          <Button x:Name="HighlighterToolButton" Style="{StaticResource SquareButton}" ToolTip="荧光笔" Tag="Highlighter" Click="PointerToolButton_OnClick"><Path Style="{StaticResource Icon}" Data="M3,18 L8,4 L23,9 L18,23 Z M8,4 L10,1 L25,6 L23,9 M3,18 L18,23 M5,20 L4,24 L11,24 L13,22"/></Button>
          <Button x:Name="EraserToolButton" Style="{StaticResource SquareButton}" ToolTip="橡皮擦" Tag="Eraser" Click="PointerToolButton_OnClick"><Path Style="{StaticResource Icon}" Data="M2,16 L14,3 L24,12 L13,24 L9,24 Z M7,11 L18,20 M13,24 L25,24"/></Button>
        </UniformGrid>
        <StackPanel x:Name="BuiltInSizePanel" Visibility="Collapsed" Margin="7,4,7,4">
          <Grid>
            <TextBlock Text="笔刷大小" Foreground="#FF353A40" VerticalAlignment="Center"/>
            <TextBlock x:Name="PenSizeValue" HorizontalAlignment="Right" Foreground="#FF278A70" FontWeight="SemiBold"/>
          </Grid>
          <Slider x:Name="PenSizeSlider" Style="{StaticResource SizeSlider}" Minimum="1" Maximum="20" Value="3.2"
                  SmallChange="0.5" LargeChange="2" ValueChanged="SizeSlider_OnValueChanged"/>
        </StackPanel>
        <UniformGrid x:Name="ColorGrid" Columns="6" Rows="2" Margin="0,6,0,6">
          <Button Style="{StaticResource Swatch}" Background="#FF111111" Tag="#111111" ToolTip="黑色" Click="ColorButton_OnClick"/>
          <Button Style="{StaticResource Swatch}" Background="#FF666666" Tag="#666666" ToolTip="深灰色" Click="ColorButton_OnClick"/>
          <Button Style="{StaticResource Swatch}" Background="#FFE53935" Tag="#E53935" ToolTip="红色" Click="ColorButton_OnClick"/>
          <Button Style="{StaticResource Swatch}" Background="#FFF4511E" Tag="#F4511E" ToolTip="橙红色" Click="ColorButton_OnClick"/>
          <Button Style="{StaticResource Swatch}" Background="#FFFFB300" Tag="#FFB300" ToolTip="橙黄色" Click="ColorButton_OnClick"/>
          <Button Style="{StaticResource Swatch}" Background="#FFFFEB3B" Tag="#FFEB3B" ToolTip="黄色" Click="ColorButton_OnClick"/>
          <Button Style="{StaticResource Swatch}" Background="#FF8BC34A" Tag="#8BC34A" ToolTip="浅绿色" Click="ColorButton_OnClick"/>
          <Button Style="{StaticResource Swatch}" Background="#FF00A65A" Tag="#00A65A" ToolTip="绿色" Click="ColorButton_OnClick"/>
          <Button Style="{StaticResource Swatch}" Background="#FF00AFC1" Tag="#00AFC1" ToolTip="青色" Click="ColorButton_OnClick"/>
          <Button Style="{StaticResource Swatch}" Background="#FF1E88E5" Tag="#1E88E5" ToolTip="蓝色" Click="ColorButton_OnClick"/>
          <Button Style="{StaticResource Swatch}" Background="#FF174A9C" Tag="#174A9C" ToolTip="深蓝色" Click="ColorButton_OnClick"/>
          <Button Style="{StaticResource Swatch}" Background="#FF8E24AA" Tag="#8E24AA" ToolTip="紫色" Click="ColorButton_OnClick"/>
        </UniformGrid>
        <Button Style="{StaticResource SquareButton}" HorizontalAlignment="Left" ToolTip="擦除当前页全部墨迹" Click="ClearInkButton_OnClick">
          <Path Style="{StaticResource Icon}" Data="M3,6 L23,6 M8,6 L8,2 L18,2 L18,6 M5,6 L7,24 L19,24 L21,6 M10,10 L10,20 M16,10 L16,20"/>
        </Button>
      </StackPanel>
    </Border>
    <Border x:Name="RootBorder" Width="58" HorizontalAlignment="Right" VerticalAlignment="Center"
            Background="#33FFFFFF" BorderBrush="#5590969E" BorderThickness="1" CornerRadius="5" Padding="4,10"
            MouseLeftButtonDown="RootBorder_OnMouseLeftButtonDown"
            TouchDown="RootBorder_OnTouchDown" TouchMove="RootBorder_OnTouchMove" TouchUp="RootBorder_OnTouchUp"
            LostTouchCapture="RootBorder_OnLostTouchCapture">
      <StackPanel>
        <Button x:Name="PreviousButton" Style="{StaticResource SquareButton}" ToolTip="上一项 / 上一张幻灯片" Click="PreviousButton_OnClick"><Path Style="{StaticResource Icon}" Data="M2,20 L12,4 L22,20 Z"/></Button>
        <Button x:Name="PenButton" Style="{StaticResource SquareButton}" ToolTip="展开墨迹工具" Click="PenButton_OnClick"><Path Style="{StaticResource Icon}" Data="M3,21 L5,14 L17,2 L23,8 L11,20 Z M15,4 L21,10 M5,14 L11,20"/></Button>
        <Button x:Name="PageButton" Style="{StaticResource SquareButton}" ToolTip="当前幻灯片 / 总幻灯片数">
          <Viewbox Width="38" Height="24" StretchDirection="DownOnly"><TextBlock x:Name="PageText" Text="--/--" FontSize="12" Foreground="#FF353A40"/></Viewbox>
        </Button>
        <Button x:Name="ExitButton" Style="{StaticResource SquareButton}" ToolTip="退出幻灯片放映" Click="ExitButton_OnClick">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="EX" FontSize="11" FontWeight="Bold" TextAlignment="Center" LineHeight="11"/>
            <TextBlock Text="IT" FontSize="11" FontWeight="Bold" TextAlignment="Center" LineHeight="11"/>
          </StackPanel>
        </Button>
        <Button x:Name="NextButton" Style="{StaticResource SquareButton}" ToolTip="下一项 / 下一张幻灯片" Click="NextButton_OnClick"><Path Style="{StaticResource Icon}" Data="M2,4 L12,20 L22,4 Z"/></Button>
      </StackPanel>
    </Border>
  </Grid>
</Window>
